# Database
DB_USER=test
DB_PASSWORD=test
DB_HOST=localhost
DB_NAME=tg_bot
DB_PORT=5432

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=test
REDIS_DB=0

# YT-DLP
# Для Docker - yt-dlp уже установлен в контейнере
YTDLP_BINARYPATH=yt-dlp
YTDLP_OUTPUTDIR=/root/downloads
YTDLP_MAXFILESIZE=1G
YTDLP_FORMAT=best

# Workers
WORKERS_NUMBER=5

# Logger
LOGGER_LVL=info

# Telegram
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_ADMINS_IDS=123456789
